                    remote {
                        url("INPUT.PROJECT_URL")
                    }
                    branch('*/${SCRIPT_BRANCH}')
                }
            }
            scriptPath("tools/merge_bot/MergeBotJenkinsfile")
            lightweight()
        }
    }
    logRotator {
        numToKeep(24)
    }
}