pipeline {
    agent {
        label "executor"
    }
    parameters {
        string(name: "BRANCH", defaultValue: "develop", description: "Execution branch.")
        string(name: "CUSTOM_TAG", description: "Tag of pushed image.")
        string(name: "DOCKERFILE_PATH", description: "Path to Dockerfile.")
        booleanParam(name: "DRY_RUN", defaultValue: false, description: "Set to true to for pipeline stability verification. No other actions will be taken.")
    }
    options {
        skipDefaultCheckout()
    }
    stages {
        stage ("Checkout branch") {
            steps {
                script {
                    git branch: BRANCH, url: 'git@github.com:mcieciora/CarelessVaquita.git'
                    withCredentials([file(credentialsId: "cv_credentials", variable: "cv_credentials_file")]) {
                        sh "cp $cv_credentials_file .credentials"
                    }
                    currentBuild.description = "Branch: ${BRANCH}\nTag: ${CUSTOM_TAG}\nDockerfile: ${DOCKERFILE_PATH}"
                }
            }
        }
        stage ("Build and push") {
            steps {
                script {
                    withEnv(getConfig(".credentials")) {
                        withEnv(getConfig(".tools_config")) {
                            sh "docker build --build-arg DEFAULT_IMAGE_TAG=${DEFAULT_IMAGE_TAG} --no-cache -t custom_image -f ${DOCKERFILE_PATH} ."
                            sh "docker tag custom_image ${DOCKERHUB_REPO}:${CUSTOM_TAG}"
                            if (DRY_RUN.toBoolean() == false) {
                                withCredentials([usernamePassword(credentialsId: "dockerhub_id", usernameVariable: "USERNAME", passwordVariable: "PASSWORD")]) {
                                    sh "docker login --username $USERNAME --password $PASSWORD"
                                    sh "docker push ${DOCKERHUB_REPO}:${CUSTOM_TAG}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            sh "docker logout"
            cleanWs()
        }
    }
}

def getConfig(fileName) {
    return readFile(fileName).split("\n") as List
}