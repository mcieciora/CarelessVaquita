pipeline {
    agent {
        label "executor"
    }
    parameters {
        string(name: "BRANCH", defaultValue: "develop", description: "Execution branch.")
        booleanParam(name: "DRY_RUN", defaultValue: false, description: "Set to true to for pipeline stability verification. No other actions will be taken.")
    }
    options {
        skipDefaultCheckout()
    }
    stages {
        stage ("Checkout branch") {
            steps {
                script {
                    withCredentials([file(credentialsId: "cv_credentials", variable: "cv_credentials_file")]) {
                        sh "cp $cv_credentials_file .credentials"
                    }
                    withEnv(getConfig(".credentials")) {
                        withCredentials([sshUserPrivateKey(credentialsId: "agent_${NODE_NAME}", keyFileVariable: "key")]) {
                            sh 'GIT_SSH_COMMAND="ssh -i $key"'
                            git branch: params.SCRIPT_BRANCH, url: 'git@github.com:mcieciora/CarelessVaquita.git'
                        }
                    }
                    currentBuild.description = "Branch: ${SCRIPT_BRANCH}"
                }
            }
        }
        stage ("Prepare test image") {
            steps {
                script {
                    withEnv(getConfig(".credentials")) {
                        if (params.BRANCH == "develop" || params.BRANCH == "master") {
                            sh "docker pull ${DOCKERHUB_REPO}:test_image"
                            sh "docker tag ${DOCKERHUB_REPO}:test_image test_image"
                        }
                        else {
                            sh "docker build --build-arg DEFAULT_IMAGE_TAG=${DEFAULT_IMAGE_TAG} --no-cache -t test_image -f automated_tests/Dockerfile ."
                        }
                    }
                }
            }
        }
        stage("Verify dependencies") {
            when {
                expression {
                    return DRY_RUN.toBoolean() == false
                }
            }
            steps {
                script {
                    Integer python_dependencies_status = sh(script: "docker run --name python_dependency_container test_image python tools/python/python_dependencies_up_to_date_verification.py", returnStatus: true)
                    if (python_dependencies_status == 100) {
                        unstable("Some dependency packages are outdated. Check log or get updated requirements.txt files from archived artifacts.")
                    }
                }
            }
            post {
                always {
                    sh "docker container cp python_dependency_container:/app/requirements ./"
                    sh "docker rm python_dependency_container"
                    archiveArtifacts artifacts: "**/requirements.txt"
                }
            }
        }
    }
    post {
        always {
            script {
                withEnv(getConfig(".credentials")) {
                    if (params.BRANCH == "develop" || params.BRANCH == "master") {
                        sh "docker rmi ${DOCKERHUB_REPO}:test_image"
                    }
                    else {
                        sh "docker rmi test_image"
                    }
                }
                cleanWs()
            }
        }
    }
}

def getConfig(fileName) {
    return readFile(fileName).split("\n") as List
}