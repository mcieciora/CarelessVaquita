pipeline {
    agent {
        label "executor"
    }
    triggers {
        cron("H 23 * * *")
    }
    parameters {
        string(name: "SCRIPT_BRANCH", defaultValue: "develop", description: "Execution branch.")
        string(name: "CUSTOM_DAYS_POLICY", defaultValue: "", description: "Custom number of days to keep docker images.")
        booleanParam(name: "DRY_RUN", defaultValue: false, description: "Set to true to for pipeline stability verification. No other actions will be taken.")
    }
    options {
        skipDefaultCheckout()
    }
    stages {
        stage ("Checkout branch") {
            steps {
                script {
                    sh "curl -OL https://raw.githubusercontent.com/mcieciora/CarelessVaquita/refs/heads/${SCRIPT_BRANCH}/.tools_config"
                    withEnv(getConfig(".tools_config")) {
                        withCredentials([sshUserPrivateKey(credentialsId: "agent_${NODE_NAME}", keyFileVariable: "key")]) {
                            sh 'GIT_SSH_COMMAND="ssh -i $key"'
                            git branch: params.SCRIPT_BRANCH, url: 'git@github.com:mcieciora/CarelessVaquita.git'
                        }
                    }
                    withCredentials([file(credentialsId: "cv_credentials", variable: "cv_credentials_file")]) {
                        sh "cp $cv_credentials_file .credentials"
                    }
                }
            }
        }
        stage("CleanUp Dockerhub images") {
            when {
                expression {
                    return DRY_RUN.toBoolean() == false
                }
            }
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: "dockerhub_id", usernameVariable: "USERNAME", passwordVariable: "PASSWORD")]) {
                        withEnv(getConfig(".tools_config")) {
                            String DAYS_NUMBER = params.CUSTOM_DAYS_POLICY ? params.CUSTOM_DAYS_POLICY : env.DAYS_TO_KEEP_DOCKERHUB_IMAGES_POLICY
                            sh "chmod +x tools/shell_scripts/delete_old_dockerhub_tags.sh"
                            String return_value = sh(script: "tools/shell_scripts/delete_old_dockerhub_tags.sh ${DAYS_NUMBER}", returnStdout: true).trim()
                            echo "${return_value}"
                            if (return_value.contains("Could not delete tag")) {
                                unstable(return_value)
                            }
                        }
                    }
                }
            }
        }
        stage("CleanUp Registry images") {
            when {
                expression {
                    return DRY_RUN.toBoolean() == false
                }
            }
            steps {
                script {
                    withEnv(getConfig(".credentials")) {
                        withEnv(getConfig(".tools_config")) {
                            String DAYS_NUMBER = params.CUSTOM_DAYS_POLICY ? params.CUSTOM_DAYS_POLICY : env.DAYS_TO_KEEP_REGISTRY_IMAGES_POLICY
                            sh "chmod +x tools/shell_scripts/delete_old_registry_tags.sh"
                            String return_value = sh(script: "tools/shell_scripts/delete_old_registry_tags.sh ${DAYS_NUMBER}", returnStdout: true).trim()
                            echo "${return_value}"
                            if (return_value.contains("Could not delete tag")) {
                                unstable(return_value)
                            }
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            script {
                cleanWs()
            }
        }
    }
}

def getConfig(fileName) {
    return readFile(fileName).split("\n") as List
}